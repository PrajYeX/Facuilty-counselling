PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# Choose DB_DIALECT: "sqlite" or "mysql"
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# If using MySQL:
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=faculty_counselling

# Link base used in emails (verification, password reset, notifications)
APP_URL=http://localhost:5173

# Email (SMTP). Leave SMTP_HOST empty to print emails to the server console instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=app_password
# SMTP_FROM="Faculty Counselling <you@example.com>"
